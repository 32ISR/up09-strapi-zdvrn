{
  "kind": "collectionType",
  "collectionName": "peoples",
  "info": {
    "singularName": "people",
    "pluralName": "peoples",
    "displayName": "People"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string"
    },
    "enrolled": {
      "type": "date"
    },
    "group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::group.group",
      "inversedBy": "people"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "student",
        "teacher"
      ]
    }
  }
}
